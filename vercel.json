{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.appointory.in"
        }
      ],
      "destination": "https://appointory.in/:path*",
      "permanent": true
    },
    {
      "source": "/doctor/profile/:slug",
      "destination": "/d/:slug",
      "permanent": true
    },
    {
      "source": "/clinic/profile/:slug",
      "destination": "/c/:slug",
      "permanent": true
    },
    {
      "source": "/lab/profile/:slug",
      "destination": "/l/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:section(patient|admin|receptionist|superadmin)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/doctor/:page(dashboard|appointments|prescriptions|reports|templates|all-reports)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/:authPage(login|register-clinic|pending-approval|maintenance|subscription-checkout)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}